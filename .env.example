DATABASE_URL=postgresql://user:password@localhost:5432/fiveagent

# Arbiter + task-framing model. Claude never proposes decisions, only frames
# the decision list and (Phase 2) arbitrates disputes.
ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-sonnet-5

# Proposing models. Any OpenAI-compatible API works here (OpenAI, DeepSeek, etc).
# Add PROPOSER_3_*, PROPOSER_4_*, ... to add more proposers later.
PROPOSER_1_NAME=gpt
PROPOSER_1_PROVIDER=openai
PROPOSER_1_MODEL=gpt-4o
PROPOSER_1_API_KEY=
PROPOSER_1_BASE_URL=https://api.openai.com/v1

PROPOSER_2_NAME=deepseek
PROPOSER_2_PROVIDER=deepseek
PROPOSER_2_MODEL=deepseek-chat
PROPOSER_2_API_KEY=
PROPOSER_2_BASE_URL=https://api.deepseek.com/v1

# Per-try timeout (seconds) for every LLM call, and how many additional
# tries a transport failure (timeout/connection error/429/5xx) gets before
# giving up (retries use a fixed 1s/2s backoff, not configurable here).
# Non-transient failures (bad request, auth, 402 insufficient balance, ...)
# are never retried regardless of this setting.
LLM_CALL_TIMEOUT_SECONDS=45
LLM_TRANSPORT_MAX_RETRIES=2
